# Copy this file to .env.local and provide deployment-specific values.
# This template contains placeholders only; never commit real credentials.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL 16+
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cybershield?schema=public

# Set true only when self-hosted behind a reverse proxy you control.
# Vercel deployments use the platform-provided x-vercel-forwarded-for header.
TRUSTED_PROXY=false

# Required in production for shared rate limits and progressive lockout.
REDIS_URL=redis://localhost:6379

# Legacy JWT configuration until the session migration is complete.
# Generate temporary development values with: openssl rand -hex 64
JWT_SECRET=replace_with_64_or_more_random_bytes
JWT_REFRESH_SECRET=replace_with_64_or_more_random_bytes

# Generate each key independently with: openssl rand -hex 32
# Required to generate OTP HMACs; use an independent random 32-byte hex key.
OTP_HMAC_SECRET=replace_with_32_random_bytes_as_64_hex_characters
DATA_ENCRYPTION_KEY=replace_with_32_random_bytes_as_64_hex_characters
AUTH_ENCRYPTION_KEY=replace_with_32_random_bytes_as_64_hex_characters
MFA_REQUIRED_FOR_GUARDIANS=false

# Required in production for email verification and password recovery.
EMAIL_PROVIDER=mock
RESEND_API_KEY=your_resend_api_key
AUTH_EMAIL_FROM="CyberShield <security@your-domain.example>"

# SMS_PROVIDER=twilio and the credentials below are required in production.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+91XXXXXXXXXX

# Licensed Aadhaar/DigiLocker provider integration.
AADHAAR_PROVIDER=mock
AADHAAR_PROVIDER_CLIENT_ID=your_provider_client_id
AADHAAR_PROVIDER_CLIENT_SECRET=your_provider_client_secret

# Optional integrations.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
GOOGLE_VISION_API_KEY=your_google_vision_api_key
EXTENSION_API_KEY=your_extension_api_key
METRICS_API_KEY=your_metrics_api_key
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn
