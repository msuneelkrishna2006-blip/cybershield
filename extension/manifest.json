{
  "manifest_version": 3,
  "name": "CyberShield India",
  "version": "1.0.0",
  "description": "India's AI-Powered Digital Safety Guardian — Real-time protection against scams, phishing, and digital threats.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://cybershield.in/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "CyberShield — Check this page"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
